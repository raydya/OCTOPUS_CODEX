# 新飞书应用，和本机 lark-cli 配置完全独立。
FEISHU_APP_ID=REPLACE_NEW_APP_ID
# App Secret 写入 .secrets/feishu_app_secret，不放在此文件中。
CODEX_WORKSPACE=/absolute/path/on/your/mac
CODEX_PORT=4500
# 仅宿主机 Codex 使用；留空继承当前终端代理。例：http://127.0.0.1:7890
CODEX_PROXY_URL=
# 留空使用宿主机 Codex 的默认模型。
CODEX_MODEL=
# 首次启动后用 pair 绑定用户；也可填新应用下的 open_id，多个用逗号分隔。
FEISHU_ALLOWED_USERS=
FEISHU_ALLOW_GROUPS=false
FEISHU_BOT_OPEN_ID=
MAX_CONCURRENT_TASKS=1
TASK_TIMEOUT_SECONDS=7200
APPROVAL_TIMEOUT_SECONDS=900
PROGRESS_INTERVAL_SECONDS=2
POSTGRES_USER=octopus
POSTGRES_DB=octopus
