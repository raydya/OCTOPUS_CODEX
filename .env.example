# 新飞书应用，和本机 lark-cli 配置完全独立。
FEISHU_APP_ID=REPLACE_NEW_APP_ID
# App Secret 写入 .secrets/feishu_app_secret，不放在此文件中。
CODEX_WORKSPACE=/absolute/path/to/Projects/rere
CODEX_PORT=4500
# 仅宿主机 Codex 使用；留空继承当前终端代理。例：http://127.0.0.1:7890
CODEX_PROXY_URL=
# 为本项目宿主机 Codex 加载 config/codex-diagnostics.json 中的线上查询授权。
CODEX_DIAGNOSTICS_ENABLED=false
# 原生文件/shell只读；自动加载MCP、skills、AGENTS，MCP只允许只读调用。
CODEX_READ_ONLY=true
# 按业务问题自动分配会话；独立临时 Codex thread 使用同模型、low 思考强度。
CODEX_TOPIC_ROUTING=true
OCTOPUS_QUERY_PORT=4501
OCTOPUS_CODE_ROOT=/Users/zhanglei/Projects/rere
# 留空使用宿主机 Codex 的默认模型。
CODEX_MODEL=
# 每轮对话使用的思考强度，Docker Compose 默认 xhigh。
CODEX_REASONING_EFFORT=xhigh
# 首次启动后用 pair 绑定用户；也可填新应用下的 open_id，多个用逗号分隔。
FEISHU_ALLOWED_USERS=
FEISHU_ALLOW_GROUPS=false
FEISHU_BOT_OPEN_ID=
# 指定答疑群的精确 chat_id，逗号分隔。群内所有成员可 @bot 使用；不授予私聊权限。
# 启用需 FEISHU_ALLOW_GROUPS=true、CODEX_READ_ONLY=true 和本应用 bot open_id。
FEISHU_SUPPORT_GROUP_IDS=
MAX_CONCURRENT_TASKS=1
TASK_TIMEOUT_SECONDS=600
MAX_PENDING_PER_USER=3
DAILY_TASK_LIMIT=100
MIN_REQUEST_INTERVAL_SECONDS=2
MAX_TOOL_CALLS=30
APPROVAL_TIMEOUT_SECONDS=900
POSTGRES_DB=octopus
